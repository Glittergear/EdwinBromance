// --------------------------------------
// Edwin Bromance Setup
//
// Version:   V0.5
// Author(s): Glittergear
// --------------------------------------
// Backup directory
BACKUP ~EdwinBromance/backup~

// Error reports sent to Glittergear
//AUTHOR ~Glittergear~
SUPPORT ~Message me on G3 or Discord~

// Version
VERSION ~v0.5~


// Translations
AUTO_TRA ~EdwinBromance/translations/%s~

ALWAYS

	/* eet compatibility */
	ACTION_IF GAME_IS ~eet~ BEGIN
		OUTER_SET bg2_chapter = 12
	END ELSE BEGIN
		OUTER_SET bg2_chapter = 0
	END
	OUTER_FOR (i=1; i<=10; i=i+1) BEGIN
		OUTER_SET bg2_chapter = bg2_chapter + 1
		OUTER_SPRINT name_source ~bg2_chapter_%i%~
		OUTER_SET EVAL ~%name_source%~ = bg2_chapter
	END

	/* Converts tra files to UTF-8 */
	// No exception, everything needs to be converted
	ACTION_DEFINE_ARRAY EdBrooconvert BEGIN END

	// any tra files used in LANGUAGE need to be reloaded after UTF-8 conversion
	ACTION_DEFINE_ARRAY EdBroreload BEGIN setup END

	LAF HANDLE_CHARSETS
		INT_VAR
			infer_charsets = 1
		STR_VAR
			tra_path = EVAL ~%MOD_FOLDER%/translations~
			noconvert_array = EdBrooconvert
			reload_array = EdBroreload
	END

END


LANGUAGE ~English~
         ~English~
         ~EdwinBromance/translations/english/setup.tra~

/* =================================== *
 *    Edwin Bromance  for BG2: ToB    *
 * =================================== */

BEGIN @0
REQUIRE_PREDICATE GAME_IS ~bg2ee tob bgt eet~ @1 /* ToB is not installed! Please install the Throne of Bhaal expansion before installing the Edwin Bromance. */
DESIGNATED 0 LABEL ~Edwin_Bromance~

/* CamDawg's custom IsValidForPartyDialogue() state. Thanks Cam!
   covers STATE_CONFUSED, STATE_FEEBLEMINDED, STATE_SILENCED, STATE_DEAD, STATE_ACID_DEATH, STATE_FLAME_DEATH, STATE_EXPLODING_DEATH, STATE_STONE_DEATH, STATE_FROZEN_DEATH, STATE_HELPLESS, STATE_STUNNED, STATE_PANIC, STATE_BERSERK, STATE_SLEEPING */
APPEND ~STATE.IDS~ ~0x80101FEF CD_STATE_NOTVALID~ UNLESS ~CD_STATE_NOTVALID~


// ----------
// Dialogues
// ----------
COMPILE ~EdwinBromance/dialogue/edwinj.d~
 // USING ~EdwinBromance/translations/english/edwinj.tra~
 //       ~EdwinBromance/translations/%s/mazzyj.tra~

// COMPILE ~EdwinBromance/dialogue/edwin25j.d~
 // USING ~EdwinBromance/translations/english/edwin25j.tra~
 //       ~EdwinBromance/translations/%s/edwin25j.tra~


// ----------------
// Compile scripts
// ----------------
EXTEND_BOTTOM ~edwin.bcs~   ~EdwinBromance/scripts/edwin.baf~
//EXTEND_BOTTOM ~mazzyd.bcs~  ~mazzy/scripts/mazzyd.baf~
//EXTEND_BOTTOM ~mazz25.bcs~  ~mazzy/scripts/mazz25.baf~

LAF HANDLE_AUDIO END
