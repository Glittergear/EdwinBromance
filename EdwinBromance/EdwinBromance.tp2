// --------------------------------------
// Edwin Bromance Setup
//
// Version:   1.3
// Author(s): Glittergear
// --------------------------------------
// Backup directory
BACKUP ~weidu_external/EdwinBromance/backup~

// Error reports sent to Glittergear
//AUTHOR ~Glittergear~
SUPPORT ~Message me on G3 or Discord~

// Version
VERSION ~1.3~


README ~EdwinBromance/EdwinBromance.txt~

ALWAYS

    //Copies tra files into the autotra-folder (to leave the originals untouched)
    DEFINE_ACTION_FUNCTION autotra_workaround BEGIN
      COPY ~EdwinBromance/Languages/english~			~weidu_external/EdwinBromance/Languages/autotra/%LANGUAGE%~
      COPY ~EdwinBromance/Languages/%LANGUAGE%~			~weidu_external/EdwinBromance/Languages/autotra/%LANGUAGE%~
    END

    LAF autotra_workaround END

// Convert tra files in UTF8 if EE and let them in ANSI if oBG

	ACTION_IF GAME_IS ~bg2ee eet~ BEGIN
//  ACTION_DEFINE_ARRAY EdwinBromance_noconvert BEGIN install END

		ACTION_DEFINE_ARRAY EdwinBromance_reload BEGIN setup END

			LAF HANDLE_CHARSETS
				INT_VAR
				infer_charsets = 1
				STR_VAR
				tra_path = EVAL ~weidu_external/EdwinBromance/Languages/autotra~
				out_path = EVAL ~weidu_external/EdwinBromance/Languages/autotra/UTF8~
				iconv_path = ~EdwinBromance/Languages/autotra/iconv~
//				 noconvert_array = EdwinBromance_noconvert
				reload_array = EdwinBromance_reload
			END

	// UTF8 only
	COPY ~weidu_external/EdwinBromance/Languages/autotra/UTF8/%LANGUAGE%~				~weidu_external/EdwinBromance/Languages/autotra/%LANGUAGE%~
	END

END


// Translations
AUTO_TRA ~weidu_external/EdwinBromance/Languages/autotra/%s~


LANGUAGE ~English~
         ~English~
         ~EdwinBromance/Languages/english/setup.tra~

/* =================================== *
 *    Edwin Bromance  for BG2: ToB    *
 * =================================== */

BEGIN @0
DESIGNATED 0
LABEL ~Edwin_Bromance-Glittergear~
REQUIRE_PREDICATE GAME_IS ~bg2ee tob bgt eet~ @1 /* Need ToB, BGT, BG2EE or EET. */

/* CamDawg's custom IsValidForPartyDialogue() state. Thanks Cam!
   covers STATE_CONFUSED, STATE_FEEBLEMINDED, STATE_SILENCED, STATE_DEAD, STATE_ACID_DEATH, STATE_FLAME_DEATH, STATE_EXPLODING_DEATH, STATE_STONE_DEATH, STATE_FROZEN_DEATH, STATE_HELPLESS, STATE_STUNNED, STATE_PANIC, STATE_BERSERK, STATE_SLEEPING */
APPEND ~STATE.IDS~ ~0x80101FEF CD_STATE_NOTVALID~ UNLESS ~CD_STATE_NOTVALID~


// ----------
// Dialogues
// ----------
COMPILE ~EdwinBromance/dialogue/edwinj.d~
 // USING ~EdwinBromance/translations/english/edwinj.tra~
 //       ~EdwinBromance/translations/%s/mazzyj.tra~

// COMPILE ~EdwinBromance/dialogue/edwin25j.d~
 // USING ~EdwinBromance/translations/english/edwin25j.tra~
 //       ~EdwinBromance/translations/%s/edwin25j.tra~


// ----------------
// Compile scripts
// ----------------
EXTEND_BOTTOM ~edwin.bcs~   ~EdwinBromance/scripts/edwin.baf~
//EXTEND_BOTTOM ~mazzyd.bcs~  ~mazzy/scripts/mazzyd.baf~
//EXTEND_BOTTOM ~mazz25.bcs~  ~mazzy/scripts/mazz25.baf~

LAF HANDLE_AUDIO END
