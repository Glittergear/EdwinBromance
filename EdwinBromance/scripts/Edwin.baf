// -------------------------------------------
// Edwin Friendship Talks
// -------------------------------------------
// Dialogue Start
IF
    InParty(Myself)
    Global("g_EdwinFriendship","GLOBAL",0)
THEN
  RESPONSE #100
    RealSetGlobalTimer("g_EdwinFriendshipTalksTimer","GLOBAL",2400) //CHANGE BACK TO 1200 LATER
    SetGlobal("g_EdwinFriendTalks","GLOBAL",1)
    SetGlobal("g_EdwinFriendship","GLOBAL",1)
END


//////////////////////////////////////////////
// 3 Timered Talks
////////////////////////////////////////////////

IF
    InParty(Myself)
    See(Player1)
    !StateCheck(Myself,CD_STATE_NOTVALID)
    !StateCheck(Player1,CD_STATE_NOTVALID)
    RealGlobalTimerExpired("g_EdwinFriendshipTalksTimer","GLOBAL")
    CombatCounter(0)
    !See([ENEMY])
    Global("g_EdwinFriendship","GLOBAL",1)
	OR(3)
    Global("g_EdwinFriendTalks","GLOBAL",1) 
    Global("g_EdwinFriendTalks","GLOBAL",3) 
    Global("g_EdwinFriendTalks","GLOBAL",5) 

THEN
  RESPONSE #100
    PlaySong(0)
    PlaySound("g_edBro")
    Dialogue(Player1)
END

IF
    InParty(Myself)
    See(Player1)
    RealGlobalTimerExpired("g_EdwinFriendshipTalksTimer","GLOBAL")
    Global("g_EdwinFriendship","GLOBAL",1)
    OR(2)
      Global("g_EdwinFriendTalks","GLOBAL",2) 
      Global("g_EdwinFriendTalks","GLOBAL",4) 
THEN
 RESPONSE #100
   IncrementGlobal("g_EdwinFriendTalks","GLOBAL",1)
END


//////////////////////////////////////////////
// Fourth talk - Edwina
////////////////////////////////////////////////


IF
    InParty(Myself)
    See(Player1)
    Global("g_EdwinFriendEdwina","GLOBAL",0)
    !Gender("Edwin",MALE)
THEN
  RESPONSE #100
    IncrementGlobal("g_EdwinFriendEdwina","GLOBAL",1)
END

IF
    InParty(Myself)
    See(Player1)
    Global("g_EdwinFriendEdwina","GLOBAL",1)
THEN
  RESPONSE #100
    IncrementGlobal("g_EdwinFriendEdwina","GLOBAL",1)
END

IF
    InParty(Myself)
    See(Player1)
    !StateCheck("Edwin",CD_STATE_NOTVALID)
    !StateCheck(Player1,CD_STATE_NOTVALID)
    CombatCounter(0)
    RealGlobalTimerExpired("g_EdwinFriendshipTalksTimer","GLOBAL")
    !See([ENEMY])
    !Gender("Edwin",MALE)
    Global("g_EdwinFriendEdwina","GLOBAL",2)
THEN
  RESPONSE #100
    PlaySong(0)
    PlaySound("g_edBro")
    MoveToObject(Player1)
    Dialogue(Player1)
END


