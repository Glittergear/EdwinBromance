//////////////////////////////////////////////
// Ninth talk - Suldy
////////////////////////////////////////////////

IF
    InParty(Myself)
    See(Player1)
    RealGlobalTimerExpired("g_EdwinFriendTalksTimer","GLOBAL")
    AreaCheck("AR2800")
    Global("g_EdwinFriendSuld","GLOBAL",0)
    GlobalGT("g_EdwinLikesPC","GLOBAL",4)
THEN
  RESPONSE #100
    IncrementGlobal("g_EdwinFriendSuld","GLOBAL",1)
END

IF
    InParty(Myself)
    See(Player1)
    AreaCheck("AR2800")
